<Window x:Class="Paint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Paint"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>

        <Style x:Key="AeroButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#002244"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MainBorder" CornerRadius="8" BorderBrush="#88FFFFFF" BorderThickness="1.5">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E6F2FF" Offset="0.0" />
                                    <GradientStop Color="#B3D9FF" Offset="0.48" />
                                    <GradientStop Color="#70BFFF" Offset="0.5" />
                                    <GradientStop Color="#CCEBFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid>
                                <Border CornerRadius="7,7,0,0" Height="14" VerticalAlignment="Top" Margin="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#D9FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#40FFFFFF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0.0" />
                                            <GradientStop Color="#CCE5FF" Offset="0.48" />
                                            <GradientStop Color="#99CCFF" Offset="0.5" />
                                            <GradientStop Color="#E6F2FF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MainBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#70BFFF" Offset="0.0" />
                                            <GradientStop Color="#B3D9FF" Offset="0.5" />
                                            <GradientStop Color="#E6F2FF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">
            
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="Aquamarine" >
                    <Button x:Name="BtnOpen" Content="Открыть" Style="{StaticResource AeroButtonStyle}" />
                    <Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource AeroButtonStyle}" />

                <Separator Margin="5, 0, 10, 0" Background="#99CCFF" Width="2"/>

                <Button x:Name="BtnPencil" Content="Карандашь" Style="{StaticResource AeroButtonStyle}" />
                    <Button x:Name="BtnEraser" Content="Ластик" Style="{StaticResource AeroButtonStyle}" />
                    <Button x:Name="BtnClear" Content="Очистить" Style="{StaticResource AeroButtonStyle}" />
                </StackPanel>

                <Canvas x:Name="DrawingCanvas" Background="White" ClipToBounds="True" />
                
            
        </DockPanel>

    </Grid>
</Window>
